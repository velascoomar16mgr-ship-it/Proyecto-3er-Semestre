    # La contraseña se guarda con salt y PBKDF2, nunca como texto legible.
    import os
    import sqlite3
    import secrets
    import hashlib
    import hmac
    from contextlib import closing

    USUARIO_PRIVADO = "admin"
    CONTRASENA_PRIVADA = "admin2026"

