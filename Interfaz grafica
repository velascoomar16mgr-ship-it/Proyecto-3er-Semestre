def tarjeta(titulo, valor, icono=None):
    # Si recibe un control Text, lo muestra directamente; si recibe texto,
    # crea el control, esto evita que aparezca la representacion del objeto.
    if isinstance(valor, ft.Text):
        valor_control = valor
    else:
        valor_control = ft.Text(str(valor), size=23, color=VERDE, weight=ft.FontWeight.BOLD)

    contenido = [
        ft.Text(titulo, size=12, color=GRIS),
        valor_control,
    ]
    if icono:
        contenido.insert(0, ft.Icon(icono, color=VERDE, size=22))

    return ft.Container(
        content=ft.Column(controls=contenido, spacing=7),
        bgcolor=BLANCO,
        padding=16,
        border_radius=12,
        expand=True,
        border=ft.Border.all(1, "#E4EAE4"),
    )


