    # PANTALLA: CAMIONES
 
    datos_camiones = [
        ("Camion ECO-01", "Plastico", "Recolecta botellas y envases"),
        ("Camion ECO-02", "Metal", "Recolecta latas y metales"),
        ("Camion ECO-03", "Papel", "Recolecta papel y carton"),
        ("Camion ECO-04", "Electronico", "Recolecta cables y componentes"),
    ]
    controles_camiones = []
    for nombre, material, descripcion in datos_camiones:
        controles_camiones.append(
            ft.Container(
                content=ft.Row(
                    controls=[
                        ft.Container(
                            content=ft.Icon(ft.Icons.LOCAL_SHIPPING_OUTLINED, color=VERDE, size=30),
                            bgcolor=VERDE_CLARO,
                            padding=12,
                            border_radius=10,
                        ),
                        ft.Column(
                            controls=[
                                ft.Text(nombre, color=TEXTO, weight=ft.FontWeight.BOLD),
                                ft.Text(f"Material asignado: {material}", color=VERDE, size=13),
                                ft.Text(descripcion, color=GRIS, size=12),
                            ],
                            spacing=4,
                            expand=True,
                        ),
                    ],
                ),
                bgcolor=BLANCO,
                padding=15,
                border_radius=12,
            )
        )

    pantalla_camiones = ft.Column(
        controls=[
            ft.Text("FLOTA", size=11, color=VERDE, weight=ft.FontWeight.BOLD),
            ft.Text("Gestion de camiones", size=27, color=TEXTO, weight=ft.FontWeight.BOLD),
            ft.Text("Vehiculos y materiales asignados dentro del sistema.", color=GRIS),
            *controles_camiones,
            ft.Text("La capacidad se define al momento de planificar cada recoleccion.", color=GRIS, size=12),
        ],
        spacing=12,
        scroll=ft.ScrollMode.AUTO,
        expand=True,
    )

   
    # PANTALLA: ESTADISTICAS
    
    pantalla_estadisticas = ft.Column(
        controls=[
            ft.Text("RENDIMIENTO", size=11, color=VERDE, weight=ft.FontWeight.BOLD),
            ft.Text("Estadisticas", size=27, color=TEXTO, weight=ft.FontWeight.BOLD),
            ft.Text("Indicadores de la ultima ruta calculada.", color=GRIS),
            ft.Row(
                controls=[
                    tarjeta("Distancia recorrida", resumen_distancia, ft.Icons.ROUTE),
                    tarjeta("Residuos recolectados", resumen_peso, ft.Icons.RECYCLING),
                ],
                spacing=12,
            ),
            ft.Row(
                controls=[
                    tarjeta("Paradas atendidas", resumen_paradas, ft.Icons.LOCATION_ON),
                    tarjeta("Material seleccionado", resumen_material, ft.Icons.CATEGORY),
                ],
                spacing=12,
            ),
            ft.Text("Nota: estos indicadores se actualizan al ejecutar una nueva recoleccion.", color=GRIS, size=12),
        ],
        spacing=18,
        scroll=ft.ScrollMode.AUTO,
        expand=True,
    )

    # MENU LATERAL Y NAVEGACION
   
    contenido = ft.Container(expand=True, padding=16)
    items_menu = {}

    def cambiar_pantalla(nombre):
        pantallas = {
            "inicio": pantalla_inicio,
            "rutas": pantalla_rutas,
            "puntos": pantalla_puntos,
            "camiones": pantalla_camiones,
            "estadisticas": pantalla_estadisticas,
        }

        contenido.content = pantallas[nombre]

        # Cambia el fondo de la opcion seleccionada
        for clave, control in items_menu.items():
            if clave == nombre:
                control.bgcolor = VERDE_MEDIO
            else:
                control.bgcolor = None

        page.update()

    def crear_opcion_menu(nombre, texto, icono):
        opcion = ft.Container(
            content=ft.Row(
                controls=[
                    ft.Icon(icono, color=BLANCO, size=20),
                    ft.Text(texto, color=BLANCO, size=14, weight=ft.FontWeight.W_500),
                ],
                spacing=13,
            ),
            padding=13,
            border_radius=9,
            on_click=lambda e: cambiar_pantalla(nombre),
            ink=True,
        )
        items_menu[nombre] = opcion
        return opcion

    menu_lateral = ft.Container(
        content=ft.Column(
            controls=[
                ft.Row(
                    controls=[
                        ft.Icon(ft.Icons.RECYCLING, color="#B8E6C3", size=30),
                        ft.Text("EcoRutas", size=22, color=BLANCO, weight=ft.FontWeight.BOLD),
                    ],
                    spacing=10,
                ),
                ft.Text("GESTION DE RECICLAJE", size=10, color="#C5D8CB", weight=ft.FontWeight.BOLD),
                ft.Divider(color="#47735B", height=20),
                crear_opcion_menu("inicio", "Inicio", ft.Icons.HOME_OUTLINED),
                crear_opcion_menu("rutas", "Planificar rutas", ft.Icons.ROUTE),
                crear_opcion_menu("puntos", "Puntos de recoleccion", ft.Icons.LOCATION_ON_OUTLINED),
                crear_opcion_menu("camiones", "Gestion de camiones", ft.Icons.LOCAL_SHIPPING_OUTLINED),
                crear_opcion_menu("estadisticas", "Estadisticas", ft.Icons.BAR_CHART),
                ft.Container(expand=True),
                ft.Divider(color="#47735B"),
            ],
            spacing=8,
            expand=True,
        ),
        width=195,
        bgcolor=VERDE,
        padding=14,
    )

    # Distribucion general: menu fijo a la izquierda y contenido a la derecha
    layout = ft.Row(
        controls=[menu_lateral, contenido],
        spacing=0,
        expand=True,
        vertical_alignment=ft.CrossAxisAlignment.STRETCH,
    )
    page.add(layout)

    # Al abrir la app se muestra Inicio y se cargan las paradas iniciales
    cambiar_material()
    cambiar_pantalla("inicio")




ft.run(main)
