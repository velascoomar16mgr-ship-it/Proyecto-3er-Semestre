    def conectar_cuenta():
        conexion = sqlite3.connect(ruta_base_datos)
        conexion.execute(
            """
            CREATE TABLE IF NOT EXISTS cuenta_privada (
                id INTEGER PRIMARY KEY CHECK (id = 1),
                usuario TEXT NOT NULL UNIQUE,
                salt BLOB NOT NULL,
                clave_hash BLOB NOT NULL
            )
            """
        )
        conexion.commit()
        return conexion

    def inicializar_cuenta_privada():
        # La cuenta única queda establecida automáticamente al iniciar EcoRutas.
        # Se actualiza el registro para garantizar las credenciales solicitadas.
        salt = secrets.token_bytes(16)
        clave_hash = hashlib.pbkdf2_hmac(
            "sha256", CONTRASENA_PRIVADA.encode("utf-8"), salt, 300000
        )
        with closing(conectar_cuenta()) as conexion:
            conexion.execute(
                """
                INSERT INTO cuenta_privada (id, usuario, salt, clave_hash)
                VALUES (1, ?, ?, ?)
                ON CONFLICT(id) DO UPDATE SET
                    usuario = excluded.usuario,
                    salt = excluded.salt,
                    clave_hash = excluded.clave_hash
                """,
                (USUARIO_PRIVADO, salt, clave_hash),
            )
            conexion.commit()

    def validar_cuenta(usuario, contrasena):
        with closing(conectar_cuenta()) as conexion:
            registro = conexion.execute(
                "SELECT usuario, salt, clave_hash FROM cuenta_privada WHERE id = 1"
            ).fetchone()

        if registro is None or usuario.strip().casefold() != registro[0].casefold():
            return False

        intento = hashlib.pbkdf2_hmac(
            "sha256", contrasena.encode("utf-8"), registro[1], 300000
        )
        return hmac.compare_digest(intento, registro[2])

