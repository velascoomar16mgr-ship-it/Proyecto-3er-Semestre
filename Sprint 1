        return "Electronico"


# =============================================================================
# 3. CONTENEDORES (Agrupación y Manejo de Colecciones en Calles)
# =============================================================================

class Contenedor:
    """Modela el contenedor físico callejero donde se depositan los residuos."""
    TIPOS = ["Plastico", "Metal", "Papel", "Electronico"]

    def __init__(self, id_contenedor: str, nombre: str, tipo_residuo: str):
        self._id = id_contenedor
        self._nombre = nombre
        self._residuos: List[Residuo] = []
        self.set_tipo_residuo(tipo_residuo)

    def get_id(self) -> str:
        return self._id

    def get_nombre(self) -> str:
        return self._nombre

    def set_nombre(self, nuevo_nombre: str):
        self._nombre = nuevo_nombre

    def get_tipo_residuo(self) -> str:
        return self._tipo_residuo

    def set_tipo_residuo(self, nuevo_tipo: str):
        if nuevo_tipo not in Contenedor.TIPOS:
            raise TipoResiduoIncompatibleException(
                f"El tipo '{nuevo_tipo}' no existe. Tipos validos: {Contenedor.TIPOS}"
            )
        if len(self._residuos) > 0 and nuevo_tipo != self._tipo_residuo:
            raise TipoResiduoIncompatibleException(
                f"No se puede cambiar el tipo de '{self._nombre}' porque ya tiene residuos."
            )
        self._tipo_residuo = nuevo_tipo

    def get_residuos(self) -> List[Residuo]:
        return list(self._residuos)

    def get_peso_total(self) -> float:
        total = 0.0
        i = 0
        while i < len(self._residuos):
            total += self._residuos[i].get_peso()
            i += 1
        return round(total, 2)

    def agregar_residuo(self, residuo: Residuo):
        if residuo.obtener_tipo() != self._tipo_residuo:
            raise TipoResiduoIncompatibleException(
                f"Rechazo en '{self.get_nombre()}': se intento depositar '{residuo.obtener_tipo()}', "
                f"pero este contenedor solo admite '{self.get_tipo_residuo()}'."
            )
        self._residuos.append(residuo)

    def vaciar(self):
        """Vacia el contenedor cuando el camión recolector recoge su contenido."""
        self._residuos = []

    def __str__(self) -> str:
        return f"Contenedor '{self.get_nombre()}' [{self.get_tipo_residuo()}] - Carga total: {self.get_peso_total():.2f} kg"


# =============================================================================
# 4. JERARQUÍA DE CAMIONES RECOLECTORES
# =============================================================================

class Camion(ABC):
    """
    CLASE BASE ABSTRACTA DE VEHÍCULOS:
    - Modela el estado general de cualquier camión: matrícula, material que transporta,
      capacidad máxima en kg y peso que lleva cargado actualmente.
    """

    def __init__(self, matricula: str, tipo_residuo: str, capacidad_maxima: float):
        self._matricula = matricula
        self._tipo_residuo = tipo_residuo
        self._capacidad_maxima = capacidad_maxima
        self._carga_actual: float = 0.0  # El camión inicia su turno vacío

    def get_matricula(self) -> str:
        return self._matricula

    def get_tipo_residuo(self) -> str:
        return self._tipo_residuo

    def get_capacidad_maxima(self) -> float:
        return self._capacidad_maxima

    def set_capacidad_maxima(self, nueva_capacidad: float):
        if nueva_capacidad <= 0:
            raise ValueError("La capacidad del camión debe ser un valor positivo.")
        self._capacidad_maxima = nueva_capacidad

    def get_carga_actual(self) -> float:
        return self._carga_actual

    def get_espacio_disponible(self) -> float:
        return self._capacidad_maxima - self._carga_actual

    def cargar_contenedor(self, contenedor: Contenedor) -> float:
        """
        Transfiere los residuos del contenedor de la calle a la tolva del camión.
        Valida compatibilidad y capacidad, sumando la carga y vaciando el contenedor.
        """
        if contenedor.get_tipo_residuo() != self._tipo_residuo:
            raise TipoResiduoIncompatibleException(
                f"El camión {self.get_matricula()} recoge '{self.get_tipo_residuo()}', "
                f"no puede atender el contenedor '{contenedor.get_nombre()}' de '{contenedor.get_tipo_residuo()}'."
            )

        peso_a_cargar = contenedor.get_peso_total()

        if peso_a_cargar > self.get_espacio_disponible():
            raise CapacidadExcedidaException(
                f"Capacidad insuficiente en camión {self.get_matricula()}. "
                f"Espacio libre: {self.get_espacio_disponible():.2f} kg, "
                f"Contenedor '{contenedor.get_nombre()}' pesa: {peso_a_cargar:.2f} kg."
            )

        self._carga_actual += peso_a_cargar
        contenedor.vaciar()
        return peso_a_cargar

    def cargar_punto(self, contenedor: Contenedor) -> float:
        """Alias polimórfico de compatibilidad con versiones previas."""
        return self.cargar_contenedor(contenedor)

    def vaciar_carga(self):
        """Reinicia la tolva del camión en 0 kg tras descargar en la estación base."""
        self._carga_actual = 0.0

    @abstractmethod
    def ejecutar_vaciado(self) -> str:
        pass


class CamionPlastico(Camion):
    def __init__(self, matricula: str, capacidad_maxima: float):
        super().__init__(matricula, "Plastico", capacidad_maxima)

    def ejecutar_vaciado(self) -> str:
