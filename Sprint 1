# CLASE Principal: RESIDUO
# Esta es la clase principal de nuestro proyecto
# Aquí colocamos las características que todos los residuos
class Residuo:

    # CONSTRUCTOR
    # El constructor se utiliza para darle informacion al objeto cuando lo creamos
    def __init__(self, nombre, peso):

        # Guardamos el nombre del residuo
        self.nombre = nombre

        # Guardamos el peso del residuo en kilogramos
        self.peso = peso

    # METODO PARA PODER MOSTRAR INFORMACION
    # Este metodo muestra los datos principales del residuo
    def mostrar_info(self):

        # Mostramos el nombre del residuo.
        print("Nombre:", self.nombre)

        # Mostramos el peso del residuo
        print("Peso:", self.peso, "kg")

