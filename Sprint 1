# =============================================================================
# 5. PUNTO DE ACOPIO (Estación Base / Planta Central de Tratamiento)
# =============================================================================

class PuntoAcopio:
    """
    Representa la Base Logística Central:
    - Aloja y despacha la flota de camiones recolectores.
    - Recibe a los camiones al final de su ruta para descargar y sumar al acumulado histórico.
    """

    def __init__(self, id_punto: str, nombre: str, direccion: str):
        self._id = id_punto
        self._nombre = nombre
        self._direccion = direccion
        self._camiones: List[Camion] = []
        self._total = 0.0

    def get_id(self) -> str:
        return self._id

    def get_nombre(self) -> str:
        return self._nombre

    def set_nombre(self, nuevo_nombre: str):
        self._nombre = nuevo_nombre

    def get_direccion(self) -> str:
        return self._direccion

    def set_direccion(self, nueva_direccion: str):
        self._direccion = nueva_direccion

    def get_camiones(self) -> List[Camion]:
        return list(self._camiones)

    def get_total(self) -> float:
        return self._total

    def buscar_camion(self, matricula: str) -> Optional[Camion]:
        i = 0
        while i < len(self._camiones):
            if self._camiones[i].get_matricula() == matricula:
                return self._camiones[i]
            i += 1
        return None

    def agregar_camion(self, camion: Camion):
        if self.buscar_camion(camion.get_matricula()) is not None:
            raise ReciclajeException(f"El camión {camion.get_matricula()} ya está registrado en '{self._nombre}'.")
        self._camiones.append(camion)

    def recibir_camion(self, camion: Camion) -> str:
        if self.buscar_camion(camion.get_matricula()) is None:
            self.agregar_camion(camion)
        if camion.get_carga_actual() <= 0:
            raise PesoInvalidoException(f"El camión {camion.get_matricula()} llegó vacío a la base.")

        mensaje = camion.ejecutar_vaciado()
        self._total += camion.get_carga_actual()
        camion.vaciar_carga()
        return mensaje

    def __str__(self) -> str:
        return f"Punto de acopio '{self._nombre}' ({self._direccion}) - Camiones: {len(self._camiones)} - Total: {self._total:.2f} kg"
